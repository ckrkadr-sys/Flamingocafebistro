{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "search.exclude": {
    ".next": true,
    "node_modules": true,
    "out": true,
    "coverage": true
  },
  "files.exclude": {
    ".next": true,
    "node_modules": true
  }
}
